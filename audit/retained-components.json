{
  "agent-stack": "<div id=\"agent-stack-block\">\n<h3 class=\"subsection-title anim-fade\">THE 7-LAYER AGENT STACK</h3>\n<p class=\"aa-stack-sub anim-fade\">Click any layer to explore tools, companies, and key data. Hover any company for details.</p>\n<div class=\"aa-stack anim-fade\">\n<!-- Layer 1: UI / Frontend -->\n<div class=\"aa-layer\" data-layer=\"1\" style=\"--layer-color: var(--accent-blue)\">\n<div class=\"aa-layer-bar\">\n<span class=\"aa-layer-num\">1</span>\n<svg aria-hidden=\"true\" class=\"aa-layer-icon\" fill=\"none\" height=\"24\" viewbox=\"0 0 24 24\" width=\"24\">\n<rect height=\"14\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"18\" x=\"3\" y=\"3\"></rect>\n<path d=\"M7 21h10M12 17v4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n<span class=\"aa-layer-name\">UI / Frontend Layer</span>\n<span class=\"aa-layer-tagline\">How agents meet users</span>\n<svg aria-hidden=\"true\" class=\"aa-layer-chevron\" fill=\"none\" height=\"20\" viewbox=\"0 0 20 20\" width=\"20\">\n<path d=\"M6 8l4 4 4-4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n<div class=\"aa-layer-detail\">\n<div class=\"aa-detail-tools\">\n<span class=\"aa-tool-chip aa-tool-chip--dvc aa-tool-chip--has-tip\" data-tip=\"CopilotKit: ecosystem example. See the dated evidence in the report for operating metrics.\">CopilotKit  <span class=\"aa-chip-dl tabnum\">515K npm/mo</span> <span class=\"aa-dvc-badge\">DVC</span></span>\n<span class=\"aa-tool-chip aa-tool-chip--has-tip\" data-tip=\"Vercel AI SDK: ecosystem example. See the dated evidence in the report for operating metrics.\">Vercel AI SDK  <span class=\"aa-chip-dl tabnum\">36.5M npm/mo</span></span>\n<span class=\"aa-tool-chip aa-tool-chip--dvc aa-tool-chip--has-tip\" data-tip=\"AG-UI Protocol: ecosystem example. See the dated evidence in the report for operating metrics.\">AG-UI  <span class=\"aa-chip-dl